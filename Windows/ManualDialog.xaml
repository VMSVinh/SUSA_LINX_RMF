<Window x:Class="NewSanofi.Windows.ManualDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ManualDialog"
        Height="220"
        Width="520"
        ResizeMode="NoResize"
        BorderBrush="#FF808080"
        BorderThickness="1"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Label x:Name="content_lbl"
               Content="Do you want to delete this recipe?"
               Background="#FF008000"
               Opacity="0.5"
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               FontSize="16"
               FontWeight="SemiBold" />
        <TextBlock x:Name="content_tbl"
                   TextWrapping="Wrap"
                   Margin="20,25,20,25"
                   Grid.Row="1"
                   Text=""
                   FontSize="14" />
        <Button x:Name="ok_btn"
                Background="{DynamicResource PrimaryHueDarkForegroundBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Grid.Row="2"
                MinWidth="100"
                Opacity="0.8"
                Content="OK"
                Margin="0,5"
                Click="ok_btn_Click" />
    </Grid>
</Window>
