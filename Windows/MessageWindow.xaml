<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NewSanofi.Windows.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#4C000000"
        AllowsTransparency="True"
        FontFamily="Cambria"
        FontSize="20"
        WindowState="Maximized">
    <Border Margin="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Height="260"
            Width="519"
            Background="#FFFFFFFF"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>
            <Border Background="#FFF0F0F0" Grid.Row="2" CornerRadius="0,0,5,5" BorderThickness="0" />
            <TextBlock x:Name="lb_message"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FF494949"
                       FontWeight="Bold"
                       Margin="10,0,10,0"
                       Grid.Row="1"
                       TextWrapping="Wrap" />
            <Grid x:Name="grid_yesno" Grid.Row="2">
                <Button x:Name="btn_ok"
                        Style="{DynamicResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Center"
                        Height="50"
                        VerticalAlignment="Center"
                        MinWidth="200"
                        Content="YES"
                        BorderThickness="1"
                        FontSize="18"
                        Margin="0,0,220,0"
                        Background="#FFFFFFFF"
                        Click="btn_ok_Click" />
                <Button x:Name="btn_cancel"
                        Style="{DynamicResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Center"
                        Height="50"
                        VerticalAlignment="Center"
                        MinWidth="200"
                        Content="NO"
                        BorderThickness="1"
                        FontSize="18"
                        Margin="220,0,0,0"
                        Background="#FFFFFFFF"
                        Click="btn_cancel_Click" />
            </Grid>
            <Border Background="{DynamicResource PrimaryHueDarkBrush}" CornerRadius="5,5,0,0" />
            <TextBlock TextWrapping="Wrap"
                       Text="Message"
                       Margin="10,8,0,8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#FFFFFFFF"
                       TextDecorations="{x:Null}" />
            <Grid x:Name="grid_message" Grid.Row="2" Visibility="Hidden">
                <Button x:Name="btn_ok1"
                        HorizontalAlignment="Center"
                        Height="50"
                        VerticalAlignment="Center"
                        Width="200"
                        Content="OK"
                        Foreground="#FFFFFFFF"
                        Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
                        BorderThickness="1"
                        BorderBrush="#FF4085FD"
                        FontSize="18"
                        Click="btn_ok_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
