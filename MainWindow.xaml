<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NewSanofi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        x:Name="MainWD"
        mc:Ignorable="d"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        SnapsToDevicePixels="True"
        DataContext="{StaticResource MainVM}"
        Title="VMS"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="{Binding WindowsState}"
        Background="White"
        Loaded="Window_Loaded">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="TopInputStyle" TargetType="{x:Type TextBox}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#9E9E9E" />
            </Style>
            <Style x:Key="TopComboStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#9E9E9E" />
            </Style>
            <Style x:Key="SidebarAddButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#17A9E6" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Width" Value="82" />
                <Setter Property="Height" Value="40" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border Background="#1588C9" CornerRadius="0" Margin="0" UseLayoutRounding="True" BorderBrush="{x:Null}">
                                <Grid UseLayoutRounding="True">
                                    <Border Name="Bd" Background="#1588C9" Margin="0" Grid.Row="1" UseLayoutRounding="True">
                                        <ContentPresenter Name="Content"
                                                          Content="{TemplateBinding Header}"
                                                          ContentSource="Header"
                                                          TextElement.FontSize="14"
                                                          Margin="6,0,6,0"
                                                          Opacity="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1C93D4" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1588C9" />
                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="#FFFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="TabControlControlTemplate1" TargetType="{x:Type TabControl}">
                <Grid Name="templateRoot" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="ColumnDefinition0" />
                        <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Name="RowDefinition0" Height="Auto" />
                        <RowDefinition Name="RowDefinition1" Height="*" />
                    </Grid.RowDefinitions>
                    <TabPanel Name="HeaderPanel"
                              Background="{DynamicResource PrimaryHueDarkBrush}"
                              Grid.Column="0"
                              IsItemsHost="True"
                              Width="216"
                              Margin="0"
                              Grid.Row="0"
                              KeyboardNavigation.TabIndex="1"
                              Panel.ZIndex="1" />
                    <Border Name="ContentPanel"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            Grid.Column="0"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            Grid.Row="1"
                            KeyboardNavigation.TabIndex="2"
                            KeyboardNavigation.TabNavigation="Local">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#98CAE3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="126" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="122" Height="60" Background="#B7D8EA" BorderBrush="#7FB6D0" BorderThickness="1">
                        <Image Source="images/vmslogo.jpg" Stretch="Uniform" Margin="2" />
                    </Border>
                    <TextBlock Text="TEST PRINTER"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Foreground="White"
                               Style="{DynamicResource MaterialDesignSubheadingTextBlock}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Button Width="50"
                            Margin="0"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Background="#FF03A9F4"
                            Content="_"
                            Command="{Binding HideCommand}"
                            CommandParameter="{Binding ElementName=MainWD}" />
                    <Button Width="50"
                            Content="X"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Background="#FFFF0000"
                            Opacity="0.8"
                            Command="{Binding CloseCommand}"
                            CommandParameter="{Binding ElementName=MainWD}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="8,6,0,0">
            <TextBlock Text="Push To Cache:" VerticalAlignment="Center" FontSize="20" Margin="5,0,10,0" />
            <ComboBox Style="{StaticResource TopComboStyle}" SelectedIndex="{Binding SelectedNumberCache}">
                <ComboBoxItem>5</ComboBoxItem>
                <ComboBoxItem>10</ComboBoxItem>
                <ComboBoxItem>15</ComboBoxItem>
                <ComboBoxItem>20</ComboBoxItem>
                <ComboBoxItem>25</ComboBoxItem>
                <ComboBoxItem>30</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="(pcs)" VerticalAlignment="Center" FontSize="20" Margin="5,0,10,0" />
            <TextBlock Text="Number Of Characters:" VerticalAlignment="Center" FontSize="20" Margin="20,0,10,0" />
            <TextBox Style="{StaticResource TopInputStyle}" Text="{Binding NumberChar}" />
        </StackPanel>

        <materialDesign:DrawerHost Grid.Row="2">
            <Grid x:Name="center_Grid">
                <TabControl x:Name="tab_scanners"
                            TabStripPlacement="Left"
                            Template="{StaticResource TabControlControlTemplate1}"
                            Background="White"
                            BorderThickness="0"
                            ItemsSource="{Binding TabControler}" />
                <Button x:Name="btn_add_scanner"
                        Style="{StaticResource SidebarAddButtonStyle}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="56,0,0,6"
                        Content="ADD"
                        IsEnabled="{Binding AddEnable}"
                        Command="{Binding AddCommand}" />
            </Grid>
        </materialDesign:DrawerHost>
    </Grid>
</Window>
