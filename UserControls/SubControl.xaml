<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NewSanofi.UserControls.SubControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="MainWD"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#17A9E6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0.95" />
        </Style>
        <Style x:Key="InfoTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Foreground" Value="#FF0000FF" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#9E9E9E" />
        </Style>
    </UserControl.Resources>
    <Grid Height="670" Width="1280">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="130" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                <Button Content="Import File" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Stretch" Command="{Binding InportExcelCommand}" />
                <TextBlock FontSize="20" VerticalAlignment="Center" Margin="10,0,10,0" Text="{Binding ExcelPath}" />
            </StackPanel>
            <StackPanel x:Name="StartRowSP" Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left">
                <TextBlock Text="Start Row: " FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Style="{StaticResource InfoTextBoxStyle}" Margin="10,0,10,10" MinWidth="100" Text="{Binding RowStart}" />
                <Button Content="Set" Style="{StaticResource ActionButtonStyle}" Command="{Binding SetCommand}" />
            </StackPanel>
        </Grid>

        <Border BorderBrush="#4C50FF" Opacity="0.8" Grid.Row="1" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="30" Text="IP Address:" />
                <TextBox x:Name="ipaddress" Style="{StaticResource InfoTextBoxStyle}" FontSize="30" Margin="10,0" Width="250" Text="{Binding IPAddress, UpdateSourceTrigger=LostFocus}" />
                <TextBlock FontSize="30" Text="Port:" />
                <TextBox x:Name="port" Style="{StaticResource InfoTextBoxStyle}" FontSize="30" Margin="10,0" Width="100" Text="{Binding Port}" />
                <Button Margin="30,0" Width="108" Style="{StaticResource ActionButtonStyle}" Content="{Binding StatusString}" Command="{Binding ConfirmCommand}" />
                <Button Margin="30,0" Width="72" Style="{StaticResource ActionButtonStyle}" Content="{Binding RunString}" Command="{Binding RunCommand}" Opacity="0.3" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Content Print:" FontSize="28" />
                <TextBlock FontSize="30" Margin="10,0" Foreground="#FF0000FF" Opacity="0.8" Text="{Binding ContentPrint}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Response Message:" FontSize="28" />
                <TextBox Style="{StaticResource InfoTextBoxStyle}" FontSize="30" Margin="10,0" Width="700" Text="{Binding ResponseMessage}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Counter:" FontSize="28" />
                <TextBlock FontSize="30" Margin="10,0" Foreground="#FF0000FF" Opacity="0.8" Text="{Binding CounterText}" />
                <Button Content="Reset" Margin="30,0" Width="86" Style="{StaticResource ActionButtonStyle}" Command="{Binding ResetCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
